DATABASE_URL=postgresql://qloo:qloo_local_dev@127.0.0.1:55432/assembly
# Hosted database: mount the instance/provider CA; certificate-chain verification stays enabled.
DATABASE_SSL_CA_FILE=
# Default verify-full checks the CA chain AND hostname. Local DB behavior is unchanged without a CA.
# ONLY for verified Cloud SQL GOOGLE_MANAGED_INTERNAL_CA private-IP certificates without SAN:
# set verify-ca with the mounted unique instance CA. Missing CA or any other mode is rejected.
DATABASE_SSL_MODE=
DATABASE_POOL_MAX=8
APP_ORIGIN=http://127.0.0.1:3102
# Worker only. Never provide these to the web service.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# local: shared token below. cloud-run: private Cloud Run IAM validates Tasks OIDC.
WORKER_AUTH_MODE=local
# Local shared private dispatch identity; at least 32 random characters.
WORKER_DISPATCH_TOKEN=
WORKER_URL=http://127.0.0.1:8080
WORKER_PORT=8080
# Hosted web dispatch only (WORKER_AUTH_MODE=cloud-run).
GOOGLE_CLOUD_PROJECT=
ASSEMBLY_TASKS_LOCATION=us-central1
ASSEMBLY_TASKS_QUEUE=assembly-research
ASSEMBLY_TASKS_INVOKER_SERVICE_ACCOUNT=
# Durable global/workspace daily allowances. Calls are charged before dispatch.
QLOO_DAILY_CALL_LIMIT=24
QLOO_WORKSPACE_DAILY_CALL_LIMIT=12
MODEL_DAILY_CALL_LIMIT=90
MODEL_WORKSPACE_DAILY_CALL_LIMIT=12
